# =============================================================================
# ENVIRONMENT & SERVER
# =============================================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_SECRET=your_32_byte_aes_encryption_key_here

# =============================================================================
# DATABASE (MONGODB ATLAS CLUSTER)
# =============================================================================
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/veltrix_hub?retryWrites=true&w=majority"

# =============================================================================
# AI PROVIDERS (OPTIONAL)
# =============================================================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# =============================================================================
# META GRAPH API (FACEBOOK)
# =============================================================================
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:5000/api/v1/meta/callback"

# =============================================================================
# X / TWITTER API v2
# =============================================================================
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
TWITTER_BEARER_TOKEN=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
